def print_butterfly(n):
    for i in range(1,n+1):
        print("*"*i,end="")
        print(" "*(2*(n-i)),end="")
        if i==n:
            print("*"*(i-1))
        else:
            print("*"*i)
    for i in range(n-1,0,-1):
        print("*"*i,end="")
        print(" "*(2*(n-i)),end="")
        print("*"*i)
print_butterfly(5)